<?xml version="1.0" encoding="utf-8"?>
<!-- Clears inherited machine/user sources (e.g. a private ClearD feed in ~/.nuget/NuGet/NuGet.Config
     that needs auth) and restores from nuget.org only. -->
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
</configuration>
